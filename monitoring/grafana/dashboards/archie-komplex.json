      "panel-6": {
        "kind": "Panel",
        "spec": {
          "id": 6,
          "title": "AI Stages – Mean Duration",
          "description": "Mean duration per chat stage, including failed and cancelled attempts. Embedding covers vector creation; retrieval covers chunk search and context construction; generation covers the entire LLM call, including waiting time and internal retries. Metrics are recorded when each stage finishes. The provider can be OpenRouter or Ollama.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "eg2e6077ivm68a"
                      },
                      "spec": {
                        "editorMode": "code",
                        "expr": "sum by (stage) (rate(archie_ai_stage_duration_seconds_sum{stage=~\"embedding|retrieval|generation\"}[$__rate_interval])) / sum by (stage) (rate(archie_ai_stage_duration_seconds_count{stage=~\"embedding|retrieval|generation\"}[$__rate_interval]))",
                        "legendFormat": "{{stage}}",
                        "range": true,
                        "instant": false
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
