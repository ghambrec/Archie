      "panel-5": {
        "kind": "Panel",
        "spec": {
          "id": 5,
          "title": "Chat Request Duration – Mean and P95",
          "description": "Mean and estimated P95 server processing time of completed NestJS chat requests, including AI service waiting time and unsuccessful requests. Browser/network latency is not included. New observations appear after a request finishes; rate-based queries need at least two scrapes. P95 is a bucket-based estimate.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "eg2e6077ivm68a"
                      },
                      "spec": {
                        "editorMode": "code",
                        "expr": "sum(rate(archie_chat_request_duration_seconds_sum[$__rate_interval])) / sum(rate(archie_chat_request_duration_seconds_count[$__rate_interval]))",
                        "legendFormat": "Mean",
                        "range": true,
                        "instant": false
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                },
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "eg2e6077ivm68a"
                      },
                      "spec": {
                        "editorMode": "code",
                        "expr": "histogram_quantile(0.95, sum by (le) (rate(archie_chat_request_duration_seconds_bucket[$__rate_interval])))",
                        "legendFormat": "P95",
                        "range": true,
                        "instant": false
                      }
                    },
                    "refId": "B",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "timeseries",
            "version": "13.2.4",
            "spec": {
              "options": {
                "legend": {
                  "calcs": [
                    "lastNotNull",
                    "max"
                  ],
                  "displayMode": "list",
                  "placement": "bottom",
