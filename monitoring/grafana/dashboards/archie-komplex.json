      "panel-3": {
        "kind": "Panel",
        "spec": {
          "id": 3,
          "title": "Machine CPU",
          "description": "Overall utilization across all CPU cores, from 0–100%. Metrics provided by Node Exporter.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "eg2e6077ivm68a"
                      },
                      "spec": {
                        "editorMode": "code",
                        "expr": "100 * (1 - avg(rate(node_cpu_seconds_total{job=\"laptop\",mode=\"idle\"}[$__rate_interval])))",
                        "legendFormat": "Laptop",
                        "range": true
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
