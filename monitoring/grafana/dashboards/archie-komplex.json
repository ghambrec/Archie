      "panel-4": {
        "kind": "Panel",
        "spec": {
          "id": 4,
          "title": "Available Machine RAM",
          "description": "MemAvailable includes memory that Linux can reclaim when needed.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "eg2e6077ivm68a"
                      },
                      "spec": {
                        "editorMode": "code",
                        "expr": "node_memory_MemAvailable_bytes{job=\"laptop\"}",
                        "legendFormat": "Available",
