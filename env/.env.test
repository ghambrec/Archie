# Env for the throwaway docker-compose.test.yml stack (make test-e2e).
# Ephemeral containers/volumes only — never point this at real data.

# --- PostgreSQL ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=postgresdb_test
POSTGRES_PORT=5432
POSTGRES_HOST=postgres-test

# --- NestJS ---
NEST_SERVER_PORT=3000
NODE_ENV=test
APP_PUBLIC_URL=http://localhost:3000

# --- Default admin user (seeded by migration SeedAdminUser1785604561957) ---
ADMIN_USER=admin@example.com
ADMIN_USER_PASSWORD=change-me

# --- Redis (nest-server sessions) ---
REDIS_URL=redis://redis-test:6379
SESSION_TTL_SECONDS=604800
SESSION_COOKIE_NAME=session_id

# --- MinIO ---
MINIO_ROOT_USER=root-user
MINIO_ROOT_PASSWORD=root-user
MINIO_APP_ACCESS_KEY=minio-app-key
MINIO_APP_SECRET_KEY=test-secret-key-not-for-production-use-only

MINIO_ENDPOINT=minio-test
MINIO_PORT=9000
MINIO_USE_SSL=false

# --- Auth ---
AUTH_MAX_LOGIN_ATTEMPTS=5
AUTH_LOGIN_LOCKOUT_SECONDS=900
