# --- PostgreSQL ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=postgresdb
POSTGRES_PORT=5432
# This host name come from container name form docker-compose file 
POSTGRES_HOST=postgres



# --- NestJS ---
NEST_SERVER_PORT=3000
NODE_ENV=development


# --- Default admin user (seeded by migration SeedAdminUser1785604561957) ---
ADMIN_USER=admin@example.com
ADMIN_USER_PASSWORD=change-me


# --- Redis (nest-server sessions) ---
# Hostname comes from the "redis" container name in docker-compose.yml
REDIS_URL=redis:6379
SESSION_TTL_SECONDS=604800


# --- MinIO ---
MINIO_ROOT_USER=user
MINIO_ROOT_PASSWORD=password1234
MINIO_APP_ACCESS_KEY=access-key-name
MINIO_APP_SECRET_KEY=very-very-very-very-long-key23421425435

MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_USE_SSL=false

# generate key with:
# openssl rand -hex 32

#Nest config
AUTH_MAX_LOGIN_ATTEMPTS=5
AUTH_LOGIN_LOCKOUT_SECONDS=900


# --- AI Service ---
AI_SERVICE_HOST=ai-service
AI_SERVICE_PORT=5001

EMBEDDING_MODEL=BAAI/bge-m3
CHUNK_SIZE=512
CHUNK_OVERLAP=50
RETRIEVAL_TOP_K=5

ANTHROPIC_API_KEY=your-anthropic-api-key
CLAUDE_MODEL=claude-sonnet-4-5-20250929
CLAUDE_TEMPERATURE=0.3

POSTGRES_DSN=postgresql://POSTGRES_USER:POSTGRES_PASSWORD@POSTGRES_HOST:5432/POSTGRES_DB
OLLAMA_HOST=http://ollama:11434
OLLAMA_GENERATION_MODEL=qwen3:1.7b
OLLAMA_VISION_MODEL=qwen2.5vl:3b
OLLAMA_EMBEDDING_MODEL=bge-m3
OLLAMA_MAX_LOADED_MODELS=1
OLLAMA_KEEP_ALIVE=5m
